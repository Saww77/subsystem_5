      "compilerArgs": ["-mcpu=cortex-m0plus", "-mthumb", "-mfloat-abi=soft", "-ffreestanding"],
      "intelliSenseMode": "gcc-arm",
      "cStandard": "gnu11",
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/config",
        "${workspaceFolder}/kernel/knlinc"
      ],
      "defines": ["_PICO_RP2040_", "CNF_SMP=1", "APP_S5_BENCH=1", "APP_TEST=1"]
    }
  ],
  "version": 4
}
